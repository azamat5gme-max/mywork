rules_version = '2';

// Правила безопасности для доски идей Bilim.
// Вставь это в Firebase: Firestore Database -> Rules -> Publish.
//
// Читать идеи могут все.
// Каждый может написать идею (до 280 символов), ставить и убирать лайки
// и удалять только свои идеи.

service cloud.firestore {
  match /databases/{database}/documents {
    match /ideas/{ideaId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['text', 'subject', 'author', 'authorName', 'createdAt', 'likes'])
        && request.resource.data.author == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 20
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 24
        && request.resource.data.createdAt is number
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0;

      // Лайки: можно менять только список лайков и только добавлять или убирать себя.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes.toSet().difference(resource.data.likes.toSet()).hasOnly([request.auth.uid])
        && resource.data.likes.toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid]);

      allow delete: if request.auth != null && resource.data.author == request.auth.uid;
    }
  }
}
